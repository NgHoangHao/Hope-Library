# ========================
# Server & CORS (Render)
# ========================
NODE_ENV=production
PORT=3001
# Danh sách domain Frontend được phép gọi API (phân tách bằng dấu phẩy, không có dấu / ở cuối)
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
ENABLE_SWAGGER=true

# Cookie cross-site (bắt buộc SameSite=none & Secure=true khi FE và BE khác domain trên HTTPS)
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
# COOKIE_DOMAIN=

# ========================
# Database (MongoDB Atlas)
# ========================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_DB_NAME=LibraryDB

# ========================
# Redis (Upstash REST API - khuyến nghị cho Render)
# ========================
UPSTASH_REDIS_REST_URL=https://<your-upstash-endpoint>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>
# Hoặc dùng Redis TLS URL:
# REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# ========================
# File Storage (Cloudinary)
# ========================
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ========================
# Email (Brevo HTTP API - cổng 443 HTTPS, hoạt động ổn định trên Render Free)
# ========================
BREVO_API_KEY=<your-brevo-api-key>
MAIL_FROM=noreply@hopelibrary.com
MAIL_FROM_NAME=Hope Library
# Fallback SMTP (nếu chạy local và không dùng BREVO_API_KEY):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USER=
# MAIL_PASSWORD=

# ========================
# JWT Authentication
# ========================
JWT_SECRET=<change-to-strong-random-secret>
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=<change-to-another-strong-random-secret>
JWT_REFRESH_EXPIRATION=7d

# ========================
# Library Business Defaults
# ========================
OTP_EXPIRATION_MINUTES=5
PASSWORD_MIN_LENGTH=8
RESERVATION_EXPIRATION_HOURS=48
OVERDUE_FINE_PER_DAY=20000
MAX_BORROW_BOOKS=3
OVERDUE_REMINDER_BEFORE_DAYS=1
